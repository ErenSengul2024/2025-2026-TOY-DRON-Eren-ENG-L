import rclpy
from rclpy.node import Node
from px4_msgs.msg import VehicleCommand, TrajectorySetpoint, VehicleLocalPosition
import time
import math


class Drone2Mission(Node):

    def __init__(self):
        super().__init__('drone2_mission')

        # Publishers
        self.cmd_pub = self.create_publisher(
            VehicleCommand,
            '/fmu/in/vehicle_command',
            10
        )

        self.traj_pub = self.create_publisher(
            TrajectorySetpoint,
            '/fmu/in/trajectory_setpoint',
            10
        )

        # Subscriber
        self.pos_sub = self.create_subscription(
            VehicleLocalPosition,
            '/fmu/out/vehicle_local_position',
            self.pos_cb,
            10
        )

        # Waypoints (NED frame, meters)
        self.waypoints = [
            [0.0, 0.0, -5.0],
            [10.0, 0.0, -5.0],
            [10.0, 10.0, -5.0],
            [0.0, 10.0, -5.0]
        ]

        self.wp_index = 0
        self.current_pos = None

        self.timer = self.create_timer(0.1, self.loop)

        self.init_sequence()

    # --------------------------------------------------

    def pos_cb(self, msg):
        self.current_pos = msg

    # --------------------------------------------------

    def init_sequence(self):
        self.get_logger().info("Drone-2 arming...")
        self.send_cmd(VehicleCommand.VEHICLE_CMD_COMPONENT_ARM_DISARM, 1.0)
        time.sleep(1.0)

        self.get_logger().info("Mission mode set...")
        self.send_cmd(
            VehicleCommand.VEHICLE_CMD_DO_SET_MODE,
            1.0,
            4.0  # PX4 Mission Mode
        )

    # --------------------------------------------------

    def send_cmd(self, cmd, p1=0.0, p2=0.0):
        msg = VehicleCommand()
        msg.command = cmd
        msg.param1 = p1
        msg.param2 = p2
        msg.target_system = 1
        msg.target_component = 1
        msg.source_system = 1
        msg.source_component = 1
        msg.from_external = True
        msg.timestamp = int(self.get_clock().now().nanoseconds / 1000)
        self.cmd_pub.publish(msg)

    # --------------------------------------------------

    def loop(self):
        if self.current_pos is None:
            return

        wp = self.waypoints[self.wp_index]

        dx = wp[0] - self.current_pos.x
        dy = wp[1] - self.current_pos.y
        dz = wp[2] - self.current_pos.z

        dist = math.sqrt(dx*dx + dy*dy + dz*dz)

        if dist < 0.5:
            self.wp_index = (self.wp_index + 1) % len(self.waypoints)
            return

        sp = TrajectorySetpoint()
        sp.position = wp
        sp.yaw = 0.0
        sp.timestamp = int(self.get_clock().now().nanoseconds / 1000)

        self.traj_pub.publish(sp)


def main(args=None):
    rclpy.init(args=args)
    node = Drone2Mission()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()
