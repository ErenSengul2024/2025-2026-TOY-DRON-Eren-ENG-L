import rclpy
from rclpy.node import Node
from px4_msgs.msg import OffboardControlMode, TrajectorySetpoint, VehicleCommand
from geometry_msgs.msg import Point
import time

class ManualTargetDrone(Node):
    def __init__(self):
        super().__init__('manual_target_drone')

        self.sp_pub = self.create_publisher(
            TrajectorySetpoint,
            '/uav2/fmu/in/trajectory_setpoint',
            10
        )

        self.mode_pub = self.create_publisher(
            OffboardControlMode,
            '/uav2/fmu/in/offboard_control_mode',
            10
        )

        self.cmd_pub = self.create_publisher(
            VehicleCommand,
            '/uav2/fmu/in/vehicle_command',
            10
        )

        self.sub = self.create_subscription(
            Point,
            '/uav2/target_position',
            self.target_cb,
            10
        )

        self.target = Point(x=0.0, y=0.0, z=-15.0)
        self.setpoint_count = 0

        self.timer = self.create_timer(0.05, self.loop)  # 20 Hz

    def target_cb(self, msg: Point):
        self.target = msg
        self.get_logger().info(
            f'New target: x={msg.x:.1f}, y={msg.y:.1f}, z={msg.z:.1f}'
        )

    def loop(self):
        # OFFBOARD MODE
        off = OffboardControlMode()
        off.timestamp = 0
        off.position = True
        off.velocity = False
        off.acceleration = False
        off.attitude = False
        off.body_rate = False
        self.mode_pub.publish(off)

        # POSITION SETPOINT
        sp = TrajectorySetpoint()
        sp.timestamp = 0
        sp.x = self.target.x
        sp.y = self.target.y
        sp.z = self.target.z
        self.sp_pub.publish(sp)

        self.setpoint_count += 1

        # ARM + OFFBOARD
        if self.setpoint_count == 20:
            self.send_cmd(VehicleCommand.VEHICLE_CMD_COMPONENT_ARM_DISARM, 1.0)
        if self.setpoint_count == 30:
            self.send_cmd(VehicleCommand.VEHICLE_CMD_DO_SET_MODE, 1.0, 6.0)

    def send_cmd(self, cmd, p1=0.0, p2=0.0):
        m = VehicleCommand()
        m.timestamp = 0
        m.command = cmd
        m.param1 = p1
        m.param2 = p2
        m.target_system = 2
        m.target_component = 1
        m.from_external = True
        self.cmd_pub.publish(m)

def main():
    rclpy.init()
    rclpy.spin(ManualTargetDrone())
    rclpy.shutdown()
